# Comma-separated allowed CIDR blocks (adjust for your Wi-Fi/Ethernet router subnet)
FIREWALL_ALLOWED_SUBNETS=0.0.0.0/0
FIREWALL_BLOCKED_IPS=
FIREWALL_RATE_LIMIT=30
FIREWALL_RATE_WINDOW=10
FIREWALL_BAN_DURATION=300
ADMIN_API_KEY=gagoako12345
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook/url
FLASK_SECRET_KEY=change-this-to-a-random-secret-string-12345